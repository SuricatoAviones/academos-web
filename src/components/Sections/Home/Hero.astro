---
import { Image } from "astro:assets";
import academosWhite from "../../../assets/logos/academos-white.png";
---

<section
  class="relative overflow-hidden flex items-center justify-center lg:justify-start min-h-[460px] sm:min-h-[600px] lg:min-h-[680px] px-6 py-14 sm:px-16 sm:py-20 lg:px-28"
  style="background: linear-gradient(90deg, #06094f 0%, #002496 100%);"
>
  <!-- Logo de fondo -->
  <div
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[480px] lg:left-auto lg:right-[-3rem] lg:translate-x-0 lg:w-[640px] opacity-[0.09] sm:opacity-[0.08] pointer-events-none select-none"
  >
    <Image
      src={academosWhite}
      alt=""
      aria-hidden="true"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="w-full h-auto"
    />
  </div>

  <!-- Contenido -->
  <div
    class="relative z-10 max-w-[19rem] sm:max-w-xl mx-auto lg:mx-0 text-center lg:text-left"
  >
    <h1
      class="text-5xl sm:text-7xl lg:text-8xl font-black text-white leading-[0.95] mb-3 sm:mb-4"
    >
      Academos
    </h1>
    <p
      class="text-lg sm:text-xl lg:text-2xl text-white font-normal leading-relaxed mb-8 sm:mb-10"
    >
      Academia de Tecnología de la<br class="hidden sm:block" /> Información
    </p>
    <a
      href="#contacto"
      class="inline-block w-full sm:w-auto text-center font-extrabold text-sm tracking-widest px-10 sm:px-12 py-3.5 sm:py-4 rounded-full no-underline transition-colors duration-200 bg-[#f5c518] text-[#1a1a1a] hover:bg-[#e0b000]"
    >
      ÚNETE
    </a>
  </div>
</section>
