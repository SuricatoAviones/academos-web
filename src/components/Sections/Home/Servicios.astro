---
import academosWhite from "../../../assets/logos/academos-white.png";
---

<section
  id="servicios"
  class="relative overflow-hidden flex items-start min-h-[360px] lg:min-h-[420px] px-8 pt-14 pb-10 sm:px-16 lg:px-28"
  style="background: linear-gradient(90deg, #06094f 0%, #002496 100%);"
>
  <div
    class="absolute right-[-4rem] top-1/2 -translate-y-1/2 w-[430px] lg:w-[560px] opacity-[0.08] pointer-events-none select-none"
  >
    <img
      src={academosWhite.src}
      alt=""
      aria-hidden="true"
      class="w-full h-auto"
    />
  </div>

  <div class="relative z-10">
    <h2 class="text-6xl lg:text-7xl font-black text-white leading-none">
      Servicios
    </h2>
  </div>
</section>
