---
interface Props {
  bgColor: string;
  titulo: string;
  texto: string;
  icono: string;
}

const { bgColor, titulo, texto, icono } = Astro.props;
---

<div
  class="rounded-2xl overflow-hidden shadow-lg w-full flex flex-col border border-gray-200"
>
  <!-- Área de ícono con color de fondo -->
  <div
    class="flex items-center justify-center py-8 px-6"
    style={`background-color: ${bgColor};`}
  >
    <img src={icono} alt={titulo} class="w-20 h-20 object-contain" />
  </div>

  <!-- Área de contenido blanca -->
  <div
    class="bg-white flex flex-col items-center text-center px-4 py-5 gap-2 flex-1"
  >
    <h3
      class="text-sm font-black uppercase tracking-wide"
      style="color: #1a237e;"
    >
      {titulo}
    </h3>
    <p class="text-sm leading-snug" style="color: #1a237e;">{texto}</p>
    <span class="mt-2 text-gray-400 text-lg">&#8964;</span>
  </div>
</div>
