---
import { Image } from "astro:assets";
import academosWhite2 from "../../assets/logos/academos-white-2.png";
---

<footer class="text-white py-12 px-4" style="background: linear-gradient(90deg, #06094f 0%, #002496 100%);">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      <!-- Columna Izquierda - Enlaces legales -->
      <div class="space-y-4 text-center md:text-left">
        <a
          href="/terminos-y-condiciones"
          class="block text-white hover:text-yellow-400 transition-colors text-lg"
        >
          Términos y condiciones
        </a>
        <a
          href="/politica-de-datos"
          class="block text-white hover:text-yellow-400 transition-colors text-lg"
        >
          Política de datos
        </a>
      </div>

      <!-- Columna Central - Logo -->
      <div class="flex justify-center">
        <Image
          src={academosWhite2}
          alt="Academos Logo"
          format="webp"
          class="h-32 w-auto"
        />
      </div>

      <!-- Columna Derecha - Información -->
      <div class="space-y-3 text-center md:text-right">
        <p class="text-lg font-medium">
          Academia de Tecnología de la Información
        </p>
        <p class="text-base">Todos los derechos reservados</p>
        <p class="text-base">Rif: J-506068133</p>
      </div>
    </div>
  </div>
</footer>
