---
interface Props {
  code: number | string;
  title: string;
  message: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  code,
  title,
  message,
  ctaHref = "/",
  ctaLabel = "VOLVER AL INICIO",
} = Astro.props;
---

<section
  class="min-h-[70vh] flex items-center justify-center px-8 py-16 sm:px-16 lg:px-28"
  style="background: linear-gradient(90deg, #06094f 0%, #002496 100%);"
>
  <div class="text-center max-w-2xl">
    <p class="text-7xl lg:text-8xl font-black text-white leading-none">
      {code}
    </p>
    <h1 class="mt-4 text-3xl lg:text-5xl font-extrabold text-white">{title}</h1>
    <p class="mt-5 text-lg lg:text-xl text-white/90 leading-relaxed">
      {message}
    </p>

    <a
      href={ctaHref}
      class="inline-block mt-10 px-10 py-4 rounded-full text-sm font-extrabold tracking-widest transition-colors"
      style="background-color: #f5c518; color: #1a1a1a;"
    >
      {ctaLabel}
    </a>
  </div>
</section>
